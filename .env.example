# Supabase (previsto para Fase 01; no se conecta en Fase 00-B)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# GroqCloud (previsto para la extracción; no se integra en Fase 00-B)
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=replace-with-supported-model
